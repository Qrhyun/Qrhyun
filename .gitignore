# 忽略系统文件
.DS_Store
Thumbs.db
ehthumbs.db

# 忽略临时文件和缓存文件
*.tmp
*.swp
*.log

# 忽略本地配置文件
*.local
*.bak

# 忽略构建文件夹
/build/
/dist/

# 忽略node_modules文件夹（如果你的项目使用了Node.js）
node_modules/

# 忽略Python虚拟环境文件夹
venv/
__pycache__/
*.pyc

# 忽略Java编译生成的文件
*.class
/classes/

# 忽略IDE相关的文件和文件夹
.idea/
.vscode/
*.iml
*.ipynb_checkpoints/

# 忽略Docker相关文件
.dockerignore
Dockerfile
.dockerenv

# 忽略个人隐私文件
config.json
.env